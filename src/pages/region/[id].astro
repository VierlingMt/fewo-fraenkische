---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getRegionSeiten } from '../../lib/region';
import { SITE } from '../../config';
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import type { ImageMetadata } from 'astro';

const bilder = import.meta.glob<ImageMetadata>('../../assets/region/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
import commons from '../../data/commons-bilder.json';

// Bildnachweis: aus dem Eintrag selbst oder aus src/data/commons-bilder.json
const nachweis = (e: { bild?: string; bildAutor?: string; bildLizenz?: string; bildLizenzUrl?: string; bildQuelle?: string }) => {
  if (e.bildAutor) return { autor: e.bildAutor, lizenz: e.bildLizenz, lizenzUrl: e.bildLizenzUrl, quelle: e.bildQuelle };
  const c = Object.values(commons).find((x) => x.datei === e.bild);
  return c ? { autor: c.autor, lizenz: c.lizenz, lizenzUrl: c.lizenzUrl ?? undefined, quelle: c.quelle } : undefined;
};
const bildFuer = (datei?: string) =>
  datei ? Object.entries(bilder).find(([pfad]) => pfad.endsWith(`/${datei}`))?.[1] : undefined;

export async function getStaticPaths() {
  const seiten = await getRegionSeiten();
  return seiten.map((seite) => ({ params: { id: seite.id }, props: { seite, alle: seiten } }));
}

const { seite, alle } = Astro.props;
const d = seite.data;
const { Content } = await render(seite);
const url = new URL(Astro.url.pathname, Astro.site).href;

type Eintrag = (typeof d.eintraege)[number];
const mapsUrl = (e: Eintrag) => {
  if (e.maps === false) return undefined;
  const query = e.maps ?? (e.ort ? `${e.name}, ${e.ort}` : undefined);
  return query ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}` : undefined;
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Region', item: new URL('/region/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
  ...(d.schemaTyp && d.schemaTyp !== 'Event'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          name: d.title,
          itemListElement: d.eintraege.map((e, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            item: {
              '@type': d.schemaTyp,
              name: e.name,
              description: e.text,
              ...(e.url && { url: e.url }),
              ...(e.ort && { address: e.ort }),
            },
          })),
        },
      ]
    : []),
];
---

<Base title={d.title} description={d.description} jsonLd={jsonLd}>
  <section class="section section--white intro">
    <div class="container">
      <p class="meta crumbs"><a href="/region/">Region</a> / {d.title}</p>
      <div class="title">
        <Icon name={d.icon} class="title__icon" />
        <h1>{d.title}</h1>
      </div>
      <div class="prose lead-text">
        <Content />
      </div>
    </div>
  </section>

  {
    d.eintraege.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="eintraege">
            {d.eintraege.map((e) => (
              <article class="card eintrag">
                {bildFuer(e.bild) && (
                  <figure class="eintrag__bild">
                    <Image
                      src={bildFuer(e.bild)!}
                      alt={e.name}
                      widths={[400, 700, 1000]}
                      sizes="(min-width: 1100px) 360px, (min-width: 700px) 50vw, 100vw"
                      format="webp"
                    />
                    <figcaption>
                      <span>{e.name}</span>
                      {nachweis(e) && (
                        <small>
                          Foto:{' '}
                          {nachweis(e)!.quelle ? (
                            <a href={nachweis(e)!.quelle} target="_blank" rel="noopener">
                              {nachweis(e)!.autor}
                            </a>
                          ) : (
                            nachweis(e)!.autor
                          )}
                          {nachweis(e)!.lizenz && (
                            <>
                              ,{' '}
                              {nachweis(e)!.lizenzUrl ? (
                                <a href={nachweis(e)!.lizenzUrl} target="_blank" rel="noopener license">
                                  {nachweis(e)!.lizenz}
                                </a>
                              ) : (
                                nachweis(e)!.lizenz
                              )}
                            </>
                          )}
                        </small>
                      )}
                    </figcaption>
                  </figure>
                )}
                <div class="card__body">
                  {e.info && <p class="eintrag__info">{e.info}</p>}
                  <h2>{e.name}</h2>
                  {e.ort && <p class="meta">{e.ort}</p>}
                  <p>{e.text}</p>
                  {(e.url || mapsUrl(e)) && (
                    <div class="eintrag__link">
                      {e.url && (
                        <a class="more" href={e.url} target="_blank" rel="noopener">
                          Website
                        </a>
                      )}
                      {mapsUrl(e) && (
                        <a class="more" href={mapsUrl(e)} target="_blank" rel="noopener">
                          Google Maps
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--white">
    <div class="container weiter">
      <div class="card cta">
        <div class="card__body">
          <p class="eyebrow">Ihre Unterkunft</p>
          <h2>Mittendrin wohnen</h2>
          <p>
            Unsere zwei Ferienwohnungen in {SITE.town} sind der ideale Ausgangspunkt für alle Tipps auf dieser
            Seite.
          </p>
          <div><a class="btn" href="/ferienwohnungen/">Ferienwohnungen ansehen</a></div>
        </div>
      </div>
      <nav aria-label="Weitere Tipps zur Region">
        <p class="eyebrow">Mehr aus der Region</p>
        <ul class="links">
          {
            alle
              .filter((s) => s.id !== seite.id)
              .map((s) => (
                <li>
                  <a href={`/region/${s.id}/`}>
                    <Icon name={s.data.icon} class="links__icon" />
                    <span class="links__text">
                      <strong>{s.data.title}</strong>
                      <span>{s.data.kurz}</span>
                    </span>
                  </a>
                </li>
              ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: 48px;
  }

  .lead-text {
    font-size: 1.12rem;
    color: var(--c-muted);
  }

  .lead-text :global(h2) {
    color: var(--c-text);
  }

  .eintraege {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }

  .eintrag .card__body > :last-child {
    margin-top: 0;
    padding-top: 0;
  }

  .eintrag .card__body > .eintrag__link {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
  }

  .eintrag__bild {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--c-line);
  }

  .eintrag__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eintrag__bild figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    padding: 28px 14px 10px;
    background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.72));
    color: #fff;
    line-height: 1.3;
  }

  .eintrag__bild figcaption span {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .eintrag__bild figcaption small {
    font-size: 0.72rem;
    opacity: 0.9;
  }

  .eintrag__bild figcaption a {
    color: #fff;
    text-decoration-color: rgb(255 255 255 / 0.5);
    text-decoration-thickness: 1px;
  }

  .eintrag h2 {
    font-size: 1.3rem;
    margin: 0;
  }

  .eintrag__info {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .weiter {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  @media (min-width: 900px) {
    .weiter {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .cta {
    background: var(--c-dark);
    color: #e9ebec;
  }

  .cta h2 {
    color: #fff;
  }

  .cta .eyebrow {
    color: #9fd99a;
  }

  .cta .btn {
    background: #fff;
    color: var(--c-dark);
    border-color: #fff;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .links a {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid var(--c-line);
    text-decoration: none;
    color: var(--c-text);
  }

  .links a:hover strong {
    color: var(--c-accent);
  }

  .links__text {
    display: flex;
    flex-direction: column;
  }

  .links__text span {
    font-size: 0.92rem;
    color: var(--c-muted);
  }

  .links :global(.links__icon) {
    flex: none;
    width: 40px;
    height: 40px;
    padding: 9px;
    border-radius: 12px;
    background: var(--c-accent-soft);
    color: var(--c-accent);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .title h1 {
    margin: 0;
  }

  .title :global(.title__icon) {
    flex: none;
    width: clamp(52px, 6vw, 72px);
    height: clamp(52px, 6vw, 72px);
    padding: clamp(12px, 1.4vw, 16px);
    border-radius: 20px;
    background: var(--c-accent-soft);
    color: var(--c-accent);
  }

  .title {
    margin-bottom: 20px;
  }
</style>
