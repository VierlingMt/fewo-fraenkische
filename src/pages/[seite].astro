---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const seiten = await getCollection('seiten');
  return seiten.map((seite) => ({ params: { seite: seite.id }, props: { seite } }));
}

const { seite } = Astro.props;
const { Content } = await render(seite);
---

<Base title={seite.data.title} description={seite.data.description}>
  <section class="section">
    <div class="container prose">
      <h1>{seite.data.title}</h1>
      <Content />
    </div>
  </section>
</Base>
