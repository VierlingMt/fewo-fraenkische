---
import '../styles/global.css';
import { SITE, NAV } from '../config';
import Logo from '../assets/logo.svg';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = SITE.description, image, type = 'website', jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} – ${SITE.claim}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
const robots = SITE.noindex || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const path = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} – News`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label={`${SITE.name} – Startseite`}>
          <Logo class="brand__mark" aria-hidden="true" />
          <span>
            <span class="brand__name">{SITE.name}</span>
            <span class="brand__claim">{SITE.claim}</span>
          </span>
        </a>
        <nav aria-label="Hauptmenü">
          <ul class="nav">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={
                      (item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <p class="site-footer__name">{SITE.name}</p>
          <p>
            {SITE.contact.name}<br />
            {SITE.contact.street}<br />
            {SITE.postalCode} {SITE.town}<br />
            <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
          </p>
        </div>
        <ul class="footer-links">
          <li><a href="/ferienwohnungen/">Ferienwohnungen</a></li>
          <li><a href="/veranstaltungen/">Veranstaltungen</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
        <ul class="footer-links">
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
          <li><a href="/agb/">AGB</a></li>
          <li><a href="/rss.xml">RSS-Feed</a></li>
        </ul>
      </div>
      <div class="container site-footer__bottom">© {year} {SITE.name} · {SITE.town} · {SITE.region}</div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: rgb(255 255 255 / 0.88);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--c-line);
    position: sticky;
    top: 0;
    z-index: 5;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--c-text);
    line-height: 1.2;
  }

  .brand :global(.brand__mark) {
    width: 46px;
    height: auto;
    flex: none;
  }

  .brand__name {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .brand__claim {
    display: block;
    font-size: 0.8rem;
    color: var(--c-muted);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    display: block;
    text-decoration: none;
    color: var(--c-text);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 6px 14px;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .nav a:hover {
    background: #efede9;
    color: var(--c-text);
  }

  .nav a[aria-current='page'] {
    background: var(--c-dark);
    color: #fff;
  }

  @media (max-width: 520px) {
    .nav a {
      padding: 6px 10px;
      font-size: 0.9rem;
    }
  }

  .site-footer {
    background: var(--c-dark);
    color: #c9cdd1;
    padding: 56px 0 24px;
    font-size: 0.95rem;
  }

  .site-footer__inner {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .site-footer p {
    margin: 0 0 8px;
  }

  .site-footer__name {
    color: #fff;
    font-weight: 750;
    font-size: 1.1rem;
  }

  .site-footer a {
    color: #fff;
    text-decoration-color: rgb(255 255 255 / 0.35);
  }

  .site-footer a:hover {
    color: #9fd99a;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .site-footer__bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.85rem;
    color: #9aa0a6;
  }
</style>
