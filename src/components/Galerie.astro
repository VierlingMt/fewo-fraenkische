---
import { Image, getImage } from 'astro:assets';
import type { Foto } from '../lib/fotos';

interface Props {
  fotos: Foto[];
  title: string;
}

const { fotos, title } = Astro.props;
// Großansicht für die Lightbox
const gross = await Promise.all(fotos.map((f) => getImage({ src: f.src, width: 1800, format: 'webp' })));
---

<div class="galerie" data-galerie>
  {
    fotos.map((foto, i) => (
      <a
        href={gross[i].src}
        class:list={['galerie__item', { 'galerie__item--gross': i === 0 }]}
        data-index={i}
        data-caption={foto.label}
      >
        <Image
          src={foto.src}
          alt={`${title}: ${foto.label}`}
          widths={i === 0 ? [600, 1000, 1400] : [400, 700]}
          sizes={i === 0 ? '(min-width: 900px) 700px, 100vw' : '(min-width: 900px) 240px, 50vw'}
          format="webp"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
        <span class="galerie__label">{foto.label}</span>
      </a>
    ))
  }
</div>

<dialog class="lightbox" data-lightbox aria-label={`Fotos ${title}`}>
  <figure>
    <img src="" alt="" data-lightbox-img />
    <figcaption data-lightbox-caption></figcaption>
  </figure>
  <button type="button" class="lightbox__btn lightbox__close" data-lightbox-close aria-label="Schließen">×</button>
  <button type="button" class="lightbox__btn lightbox__prev" data-lightbox-prev aria-label="Vorheriges Foto">‹</button>
  <button type="button" class="lightbox__btn lightbox__next" data-lightbox-next aria-label="Nächstes Foto">›</button>
</dialog>

<script>
  const galerie = document.querySelector<HTMLElement>('[data-galerie]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (galerie && dialog) {
    const items = [...galerie.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const item = items[current];
      img.src = item.href;
      img.alt = item.querySelector('img')?.alt ?? '';
      caption.textContent = `${item.dataset.caption} (${current + 1}/${items.length})`;
    };

    items.forEach((item, i) =>
      item.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .galerie {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 32px;
  }

  @media (min-width: 640px) {
    .galerie {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .galerie__item {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 10px;
    background: var(--c-sand);
  }

  .galerie__item--gross {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }

  .galerie__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .galerie__item:hover :global(img) {
    transform: scale(1.03);
  }

  .galerie__label {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-size: 0.8rem;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 15 12 / 0.94);
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgb(10 15 12 / 0.94);
  }

  .lightbox figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 56px 16px 24px;
  }

  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 120px);
    object-fit: contain;
  }

  .lightbox__btn {
    position: absolute;
    border: 0;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    cursor: pointer;
  }

  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.25);
  }

  .lightbox__close {
    top: 12px;
    right: 12px;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: 12px;
  }

  .lightbox__next {
    right: 12px;
  }
</style>
