---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getFotos } from '../lib/fotos';

interface Props {
  wohnung: CollectionEntry<'wohnungen'>;
}

const { wohnung } = Astro.props;
const d = wohnung.data;
const titelbild = getFotos(wohnung.id)[0];
const facts = [
  d.personen && (d.personenMin ? `${d.personenMin}–${d.personen} Personen` : `bis ${d.personen} Personen`),
  d.schlafzimmer && `${d.schlafzimmer} Schlafzimmer`,
  d.groesse && `${d.groesse} m²`,
].filter(Boolean);
---

<article class="card">
  <a href={`/ferienwohnungen/${wohnung.id}/`} class="card__img" tabindex="-1" aria-hidden="true">
    {
      titelbild ? (
        <Image
          src={titelbild.src}
          alt=""
          widths={[400, 700, 1000]}
          sizes="(min-width: 960px) 540px, 100vw"
          format="webp"
        />
      ) : d.bild ? (
        <img src={d.bild} alt="" loading="lazy" width="900" height="600" />
      ) : (
        <div class="placeholder-img">Foto folgt</div>
      )
    }
  </a>
  <div class="card__body">
    <h3><a href={`/ferienwohnungen/${wohnung.id}/`}>{d.title}</a></h3>
    {
      facts.length > 0 && (
        <ul class="chips">
          {facts.map((f) => (
            <li class="chip">{f}</li>
          ))}
        </ul>
      )
    }
    <p>{d.teaser}</p>
    <p class="price">
      {d.preisAb ? <>ab <strong>{d.preisAb} €</strong> / Nacht</> : 'Preise auf Anfrage'}
    </p>
    <div>
      <a class="btn" href={`/ferienwohnungen/${wohnung.id}/`}>Wohnung ansehen</a>
    </div>
  </div>
</article>

<style>
  h3 a {
    text-decoration: none;
    color: inherit;
  }

  .card__img {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  h3 {
    font-size: 1.5rem;
  }

  .card__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card__img:hover :global(img) {
    transform: scale(1.03);
  }
</style>
